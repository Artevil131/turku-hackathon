{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "explore",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--bind",
        "127.0.0.1"
      ],
      "port": 8765
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "api-unified",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "AEI_PORT=8790",
        "pnpm",
        "dev:api"
      ],
      "port": 8790
    },
    {
      "name": "web-unified",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "AEI_API_URL=http://localhost:8790",
        "pnpm",
        "--filter",
        "@aei/web",
        "exec",
        "vite",
        "--port",
        "5180",
        "--strictPort"
      ],
      "port": 5180
    },
    {
      "name": "web-ux",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "AEI_API_URL=http://localhost:8795",
        "pnpm",
        "--filter",
        "@aei/web",
        "exec",
        "vite",
        "--port",
        "5181",
        "--strictPort"
      ],
      "port": 5181
    },
    {
      "name": "api-ux",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "AEI_PORT=8795",
        "pnpm",
        "dev:api"
      ],
      "port": 8795,
      "autoPort": false
    }
  ]
}