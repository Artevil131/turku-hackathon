{
  "name": "aei",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @aei/api --filter @aei/web dev",
    "dev:web": "pnpm --filter @aei/web dev",
    "dev:api": "pnpm --filter @aei/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run && uv run pytest -q libs/utils/py/tests",
    "check": "biome check .",
    "format": "biome check --write .",
    "test:ts": "vitest run",
    "smoke": "pnpm --filter @aei/web smoke"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
