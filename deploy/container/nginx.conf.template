# The web app and the API on one origin. ${AEI_API_UPSTREAM} is filled in at start.
server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;

  # Compress text: the built CSS and JavaScript, SVG, and the API's JSON (proxied responses included). HTML is always
  # on the list. HTTP/1.0 too, because the host's nginx proxies here with HTTP/1.0 by default. The event stream is
  # not on the list and gzip is off in its location: compressing it would hold events back until a buffer fills.
  gzip on;
  gzip_comp_level 5;
  gzip_min_length 1024;
  gzip_vary on;
  gzip_proxied any;
  gzip_http_version 1.0;
  gzip_types text/css application/javascript text/javascript application/json application/x-ipynb+json image/svg+xml text/plain text/csv;

  # Server-sent events: no buffering, no compression, long reads.
  location = /api/live {
    proxy_pass http://${AEI_API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
    gzip off;
  }

  # Lab results reach the API on its private loopback port (scripts/send_lab_results.py), never through the public
  # site: a file one visitor sends would otherwise join the data every visitor sees (Artem, 2026-10-18).
  location = /api/ingest {
    default_type application/json;
    return 403 '{"error":"This public demo does not accept lab files. Checking a file on the Data page stays in your browser."}';
  }

  location /api/ {
    proxy_pass http://${AEI_API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_read_timeout 120s;
  }

  # Project contents are live; the rest of JupyterLite is static.
  location /notebook/api/contents/projects/ {
    proxy_pass http://${AEI_API_UPSTREAM}/api/lite/contents/projects/;
    proxy_set_header Host $host;
  }

  location /notebook/files/projects/ {
    proxy_pass http://${AEI_API_UPSTREAM}/api/lite/files/projects/;
    proxy_set_header Host $host;
  }

  location /notebook/ {
    try_files $uri $uri/ =404;
  }

  # The language-model proxy, or a 404 when no model is set: written at start by 40-aei-llm.sh.
  include /etc/nginx/aei-llm.inc;

  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  location / {
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }
}
