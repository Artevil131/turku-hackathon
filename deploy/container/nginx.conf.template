# The web app and the API on one origin. ${AEI_API_UPSTREAM} is filled in at start.
server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;

  # Server-sent events: no buffering, long reads.
  location = /api/live {
    proxy_pass http://${AEI_API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
  }

  location /api/ {
    proxy_pass http://${AEI_API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    client_max_body_size 20m; # lab batches posted to /api/ingest
    proxy_read_timeout 120s;
  }

  # The language-model proxy, or a 404 when no model is set: written at start by 40-aei-llm.sh.
  include /etc/nginx/aei-llm.inc;

  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  location / {
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }
}
