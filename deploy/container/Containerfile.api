# The AEI server (apps/api) for a demo or pilot. Build from the repository root:
#   podman build --format docker -f deploy/container/Containerfile.api -t aei-api .
# The dataset is mounted at run time on /data (see compose.yaml); it is not in the image.
FROM node:22.23.1-slim

ENV NODE_ENV=production \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    AEI_PORT=8787 \
    AEI_DATA_DIR=/data \
    AEI_REGIONAL=/regional/regional.json

WORKDIR /app
RUN corepack enable

# The API has no npm dependencies outside the workspace; the install only links
# @aei/* packages, so Node runs their TypeScript sources directly (D-004).
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY libs/utils libs/utils
COPY apps/api apps/api
RUN pnpm install --frozen-lockfile --prod --filter "@aei/api..." && rm -rf /root/.local/share/pnpm /root/.cache

USER node
WORKDIR /app/apps/api
EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:' + (process.env.AEI_PORT || 8787) + '/api/meta').then((r) => process.exit(r.ok ? 0 : 1), () => process.exit(1))"]
CMD ["node", "src/main.ts"]
