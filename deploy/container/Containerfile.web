# The AEI web app (apps/web) built to static files and served by nginx, which
# proxies /api to the API container. Build from the repository root:
#   podman build --format docker -f deploy/container/Containerfile.web -t aei-web .
FROM node:22.23.1-slim AS build
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY libs/utils libs/utils
COPY apps/web apps/web
RUN pnpm install --frozen-lockfile --filter "@aei/web..."
# 1 when the container will proxy /llm to a model (AEI_LLM_URL at run time): the app then looks for it.
ARG AEI_LLM_PROXY=0
RUN AEI_LLM_PROXY=$AEI_LLM_PROXY pnpm --filter @aei/web build

FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS notebook
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl bzip2 \
    && rm -rf /var/lib/apt/lists/*
# Pin micromamba, rather than letting a new release change the notebook builder.
RUN download="$(mktemp -d)" \
    && curl -fsSL https://micro.mamba.pm/api/micromamba/linux-64/2.3.3 -o "$download/micromamba.tar.bz2" \
    && tar -xjf "$download/micromamba.tar.bz2" -C "$download" bin/micromamba \
    && install "$download/bin/micromamba" /usr/local/bin/micromamba \
    && rm -rf "$download"
WORKDIR /app
COPY apps/notebook apps/notebook
COPY libs/utils/py libs/utils/py
RUN apps/notebook/build.sh /notebook

FROM nginx:1.30.6-alpine
# Rendered at start by the image's entrypoint (envsubst on *.template), so the
# API's address is set at run time: AEI_API_UPSTREAM, default api:8787.
ENV AEI_API_UPSTREAM=api:8787
COPY deploy/container/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY deploy/container/40-aei-llm.sh /docker-entrypoint.d/40-aei-llm.sh
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
COPY --from=notebook /notebook /usr/share/nginx/html/notebook
EXPOSE 8080
